rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function logado() { return request.auth != null; }
    function perfil() { return get(/databases/$(db)/documents/usuarios/$(request.auth.uid)).data; }
    function ativo()  { return logado() && exists(/databases/$(db)/documents/usuarios/$(request.auth.uid)) && perfil().ativo == true; }
    function papel()  { return perfil().role; }
    function podeEscrever() { return ativo() && papel() in ['admin', 'sst']; }

    // Perfis de acesso: somente admin gerencia
    match /usuarios/{uid} {
      allow read: if ativo() || (logado() && request.auth.uid == uid);
      allow write: if ativo() && papel() == 'admin';
    }

    // Cadastros e dados operacionais (nada é excluído, apenas inativado)
    match /{colecao}/{docId} {
      allow read: if ativo() && colecao in ['empresas','setores','ghes','epis','examesCatalogo','funcionarios','asos','entregasEpi','config'];
      allow create, update: if podeEscrever() && colecao in ['empresas','setores','ghes','epis','examesCatalogo','funcionarios','asos','entregasEpi','config'];
      allow delete: if false;
    }
  }
}
